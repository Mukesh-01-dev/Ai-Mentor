PORT=5000

JWT_SECRET=your_jwt_secret

AI_SERVICE_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============ DATABASE CONFIGURATION ============
# Choose ONE of the following options:

# OPTION 1: Local PostgreSQL (Recommended for development)
# Uncomment and fill these if using local PostgreSQL
DB_NAME=ai_mentor_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

# OPTION 2: Neon (Cloud Postgres)
# Uncomment and fill this if using Neon cloud database
# NEON_DATABASE_URL=postgresql://neondb_owner:your_password@your_host/your_db?sslmode=verify-full&channel_binding=require

# Optional: database connection pool settings
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=10000
DB_POOL_IDLE=10000

# ============ EMAIL CONFIGURATION ============
# Go to your Google Account Security settings.
# Enable 2-Step Verification.
# Search for "App Passwords" and create one for "AI Mentor".
# Copy the 16-character code.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_mail@gmail.com
# 16-character app password generated by Google "App Passwords"
SMTP_PASS=your_app_password
FROM_EMAIL=your_mail@gmail.com
FROM_NAME=AI-Mentor