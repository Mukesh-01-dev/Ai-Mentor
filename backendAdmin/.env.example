# ==========================================
# 🚀 AI-MENTOR BACKEND ADMIN ENVIRONMENT
# ==========================================
# This is a template file. Please duplicate this file,
# rename it to `.env`, and fill in the values below.

# ------------------------------------------
# 1. Server Configuration
# ------------------------------------------
# The port the admin backend will run on. Usually 5001 to avoid conflicting with the main backend (5000)
PORT=5001

# The URL of the frontend admin dashboard (for CORS and redirects)
FRONTEND_URL=http://localhost:5174

# The URL of the python AI service
AI_SERVICE_URL=http://127.0.0.1:8000

# ------------------------------------------
# 2. Database Connection (Neon DB / PostgreSQL)
# ------------------------------------------
# The full connection string for your Neon Database. MUST match the main backend's database.
NEON_DATABASE_URL=postgresql://neondb_owner:your_password@your_host/your_db?sslmode=require

# Database connection pool settings
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=10000
DB_POOL_IDLE=10000

# ------------------------------------------
# 3. Authentication & Security
# ------------------------------------------
# Secret key for generating JSON Web Tokens. Make this a long, random string in production!
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRE=30d

# ------------------------------------------
# 4. Super Admin Setup
# ------------------------------------------
# When running `npm run seed:superadmin`, these credentials will be used
# to create the master admin account in the database.
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=strong_admin_password

# ------------------------------------------
# 5. Cloudinary Storage (For Image/Video Uploads)
# ------------------------------------------
# Get these from your Cloudinary Dashboard
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------
# 6. Email Setup (SMTP - For Sending Emails)
# ------------------------------------------
# Recommended: Google Workspace or Gmail App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
# Use a 16-character Google App Password here, NOT your actual email password
SMTP_PASS=your_app_password

# The email address users will see in the "From" field
FROM_EMAIL=your_email@gmail.com
FROM_NAME=AI-Mentor Admin

# ------------------------------------------
# 7. Stripe Payment Gateway
# ------------------------------------------
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# env updated
